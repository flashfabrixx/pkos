root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown often uses trailing two-spaces for line breaks.
[*.md]
trim_trailing_whitespace = false

# Makefile-style files require tabs.
[Makefile]
indent_style = tab

# pnpm-lock + package-lock manage their own formatting.
[{pnpm-lock.yaml,package-lock.json}]
indent_size = unset
trim_trailing_whitespace = unset
