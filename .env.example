# Required: identity for the single-user account
PKOS_USERNAME=marcel

# Required: password for that account.
# Run `pnpm setup:password` and paste the PKOS_PASSWORD_HASH it prints here.
# Do NOT use plaintext PKOS_PASSWORD in production — it is supported only for
# initial bootstrap and emits a security warning at runtime.
PKOS_PASSWORD_HASH=
# PKOS_PASSWORD=

# Required: random secret used to sign session cookies.
# Generate one with `openssl rand -base64 48`.
SESSION_SECRET=

# Required: Postgres credentials. Used by both docker-compose and the app.
POSTGRES_DB=pkos
POSTGRES_USER=pkos
POSTGRES_PASSWORD=
DATABASE_URL=postgres://pkos:${POSTGRES_PASSWORD}@localhost:5433/pkos

# Filesystem path for the markdown archive
PKOS_VAULT_PATH=./vault

# Filesystem path for uploaded attachments (B4). Use a writable directory
# outside the repo for any non-toy install; back this up alongside Postgres.
PKOS_FILES_PATH=./files

# Optional: maximum upload size in megabytes for /api/v1/captures/upload.
# Defaults to 25.
PKOS_MAX_UPLOAD_MB=25

# Optional: IMAP mailbox to poll for incoming captures (B5).
# When MAIL_HOST is empty, the scheduled poll task is a no-op.
# MAIL_FROM_ALLOW is a comma-separated allow-list; leave empty to accept
# any sender that lands in the inbox.
MAIL_HOST=
MAIL_PORT=993
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=true
MAIL_FROM_ALLOW=

# Optional: outbound SMTP for action reminders (B10).
# Set PKOS_REMINDER_EMAIL to the address that should receive the daily
# 07:00 digest. SMTP_HOST=blank → mailer is a no-op (logs intended send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=
PKOS_REMINDER_EMAIL=

NUXT_PUBLIC_APP_NAME=PKOS

# Extraction provider: placeholder | openrouter | ollama
PKOS_EXTRACTOR_PROVIDER=placeholder
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Embedding provider: placeholder | ollama | openai
# Multilingual (EN + DE etc.) is the design goal.
# - ollama default: bge-m3 (1024 dim, multilingual). `ollama pull bge-m3` first.
# - openai default: text-embedding-3-small with dimensions=1024 (multilingual).
# - placeholder: no embeddings written; semantic search and similarity disabled.
PKOS_EMBEDDING_PROVIDER=placeholder
PKOS_EMBEDDING_MODEL=
OPENAI_API_KEY=

# Optional: log level for the structured JSON logger.
# Accepts trace | debug | info | warn | error | fatal.
# Defaults to "info" in production and "debug" otherwise.
LOG_LEVEL=info
