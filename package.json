{
  "name": "pkos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pkos/web dev",
    "dev:portless": "portless alias pkos 3000 --force",
    "build": "pnpm --filter @pkos/web build",
    "typecheck": "pnpm --filter @pkos/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "pkos:setup": "node scripts/setup-cli.mjs",
    "pkos:hash-password": "node scripts/hash-password.mjs",
    "pkos:reset-2fa": "node scripts/reset-2fa.mjs",
    "db:embed": "node scripts/backfill-embeddings.mjs",
    "db:detect-language": "node scripts/backfill-language.mjs",
    "pkos:export": "node scripts/pkos-export.mjs",
    "pkos:import": "node scripts/pkos-import.mjs"
  },
  "dependencies": {
    "franc-min": "^6.2.0",
    "pg": "^8.21.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "h3": "^1.15.0",
    "portless": "^0.13.0",
    "tailwindcss": "^4.3.0",
    "testcontainers": "^12.0.0",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  }
}
