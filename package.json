{
  "name": "bkos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "pnpm --filter @bkos/web dev",
    "dev:portless": "portless alias bkos 3000 --force",
    "build": "pnpm --filter @bkos/web build",
    "typecheck": "pnpm --filter @bkos/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "setup:password": "node scripts/hash-password.mjs",
    "setup:reset-2fa": "node scripts/reset-2fa.mjs",
    "db:embed": "node scripts/backfill-embeddings.mjs",
    "db:detect-language": "node scripts/backfill-language.mjs",
    "bkos:export": "node scripts/bkos-export.mjs",
    "bkos:import": "node scripts/bkos-import.mjs"
  },
  "dependencies": {
    "franc-min": "^6.2.0",
    "pg": "^8.16.3",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testcontainers/postgresql": "^10.13.2",
    "@vitest/coverage-v8": "^2.1.8",
    "h3": "^1.15.0",
    "portless": "^0.13.0",
    "tailwindcss": "^4.3.0",
    "testcontainers": "^10.13.2",
    "vitest": "^2.1.8"
  }
}
